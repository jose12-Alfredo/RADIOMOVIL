  "narrative": {
    "northStar": "Acceso empresarial sobrio",
    "overview": "Dirección aprobada: legibilidad, precisión y una tarea principal clara. La identidad se apoya en azul marino, blanco de trabajo y tipografía de interfaz; el carácter proviene de la composición y del monograma geométrico, sin decoración excesiva.",
    "keyCharacteristics": ["Composición plana y contraste entre bienvenida y trabajo.", "Controles legibles, etiquetas persistentes y foco visible.", "Marca tipográfica e iconos SVG geométricos, sin recursos raster de interfaz."],
    "rules": [{ "name": "The Estado explícito Rule.", "body": "Cada estado se comunica con texto y semántica; cerrar sesión correctamente es información, no error.", "section": "colors" }],
    "dos": ["**Do** Mantener la dirección sobria, la jerarquía tipográfica y el espacio de trabajo blanco.", "**Do** Conservar etiquetas, foco visible, estados textuales y acciones utilizables en móvil.", "**Do** Separar evidencia offline de autenticación real y confirmar datos operativos con el backend."],
    "donts": ["**Don't** Añadir sombras, gradientes, raster o animación decorativa a esta dirección aprobada.", "**Don't** Presentar el cierre de sesión correcto como error.", "**Don't** Convertir planes de navegación o métricas simuladas en componentes ya implementados."]
  }
