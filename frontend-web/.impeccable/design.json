    {
      "name": "Acción principal", "kind": "button", "refersTo": "button-primary",
      "description": "Entrada empresarial; muestra habilitada, no prueba de login.",
      "html": "<button class=\"ds-primary\" type=\"button\">Entrar a RadioMovil<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{width:100%;min-height:50px;border-radius:var(--radius-control,6px);padding:13px 18px;font:600 15px var(--font-interface,'Segoe UI',system-ui,sans-serif);display:flex;align-items:center;justify-content:center;gap:16px;background:var(--color-action,#184f9d);border:1px solid var(--color-action,#184f9d);color:var(--color-surface,#fff);cursor:pointer}.ds-primary svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;flex-shrink:0}.ds-primary:hover:not(:disabled){background:var(--color-action-hover,#123c77)}.ds-primary:focus-visible{outline:3px solid #2971cb;outline-offset:4px}.ds-primary:disabled{background:#e6ebf1;border-color:#e6ebf1;color:var(--color-muted,#526071);cursor:not-allowed}"
    },
    {
      "name": "Acción secundaria", "kind": "button", "refersTo": "button-secondary",
      "description": "Comprobar sesión y acciones de estado.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Comprobar sesión</button>",
      "css": ".ds-secondary{width:100%;min-height:50px;border-radius:var(--radius-control,6px);padding:13px 18px;font:600 15px var(--font-interface,'Segoe UI',system-ui,sans-serif);display:flex;align-items:center;justify-content:center;color:var(--color-action,#184f9d);background:var(--color-surface,#fff);border:1px solid #8a98a9;cursor:pointer}.ds-secondary:hover:not(:disabled){background:#edf3fa}.ds-secondary:focus-visible{outline:3px solid #2971cb;outline-offset:4px}.ds-secondary:disabled{cursor:not-allowed}"
    },
    {
      "name": "Mostrar contraseña", "kind": "button", "refersTo": "password-toggle",
      "description": "Control dentro del campo en la aplicación; muestra visual sin lógica React.",
      "html": "<button class=\"ds-toggle\" type=\"button\" aria-label=\"Mostrar contraseña\" aria-pressed=\"false\">Mostrar</button>",
      "css": ".ds-toggle{min-height:44px;padding:0 12px;border:0;background:transparent;color:var(--color-action,#184f9d);font:600 13px var(--font-interface,'Segoe UI',system-ui,sans-serif);border-radius:4px;cursor:pointer}.ds-toggle:hover{background:#edf3fa}.ds-toggle:focus-visible{outline:3px solid #2971cb;outline-offset:4px}.ds-toggle:disabled{cursor:not-allowed}"
    },
    {
      "name": "Campo de correo", "kind": "input", "refersTo": "input",
      "description": "Etiqueta persistente, borde visible y validación textual asociada en la aplicación.",
      "html": "<div class=\"ds-field\"><label for=\"ds-email\">Correo electrónico</label><input id=\"ds-email\" type=\"email\" autocomplete=\"username\" placeholder=\"nombre@tuempresa.com\" /></div>",
      "css": ".ds-field{font-family:var(--font-interface,'Segoe UI',system-ui,sans-serif);color:var(--color-ink,#17212f);margin-bottom:22px}.ds-field label{display:block;font-size:14px;font-weight:600;margin-bottom:9px}.ds-field input{width:100%;min-width:0;height:50px;padding:12px 14px;font:inherit;color:var(--color-ink,#17212f);border:1px solid #8a98a9;border-radius:var(--radius-control,6px);background:var(--color-surface,#fff);caret-color:var(--color-action,#184f9d)}.ds-field input::placeholder{color:#647184}.ds-field input:hover{border-color:var(--color-muted,#526071)}.ds-field input:focus-visible{outline:3px solid #2971cb;outline-offset:4px}.ds-field input[aria-invalid=true]{border-color:var(--color-danger,#a52424)}.ds-field input:disabled{background:var(--color-canvas,#f4f6f8)}"
    },
    {
      "name": "Aviso informativo", "kind": "custom", "refersTo": "notice",
      "description": "Configuración pendiente o confirmación informativa; no indica fallo.",
      "html": "<div class=\"ds-notice\" role=\"status\"><strong>Configuración pendiente</strong><p>El acceso de esta instalación aún no está habilitado. Contacta con tu administrador para configurar la empresa y la conexión.</p></div>",
      "css": ".ds-notice{padding:14px 16px;background:#f1f5fa;color:#34485e;border-radius:var(--radius-control,6px);font:13px/1.6 var(--font-interface,'Segoe UI',system-ui,sans-serif);margin-bottom:24px;overflow-wrap:anywhere}.ds-notice strong{display:block;font-weight:650;margin-bottom:4px}.ds-notice p{margin:0}"
