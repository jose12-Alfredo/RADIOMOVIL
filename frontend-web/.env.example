# Copiar a .env.local. Rutas absolutas fuera del repositorio.
FRONTEND_HTTPS_CERT=C:/ruta/localhost.pem
FRONTEND_HTTPS_KEY=C:/ruta/localhost.key
# Dejar vacío hasta comprobar un host iniciado explícitamente en Testing.
API_ENVIRONMENT=Testing
TESTING_API_URL=
TESTING_API_CA=
# Identificador público de la empresa real, provisionado por el responsable; no es un secreto.
# No usar una empresa creada por las pruebas. No hay valor predeterminado.
VITE_EMPRESA_ID=
# Central de esta instalación. Dejar vacío hasta verificar que pertenece a la empresa:
# sin valor, la aplicación bloquea el registro. No hay valor predeterminado.
VITE_CENTRAL_ID=
